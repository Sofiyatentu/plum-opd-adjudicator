# Database (NeonDB PostgreSQL)
DATABASE_URL=postgresql+asyncpg://user:password@host/dbname

# OpenAI API Key (for GPT-4o Vision document extraction)
OPENAI_API_KEY=sk-your-key-here

# CORS - Set to your frontend URL, or * for all origins
CORS_ORIGINS=*

# File uploads directory
UPLOAD_DIR=./uploads

# Environment
APP_ENV=production
