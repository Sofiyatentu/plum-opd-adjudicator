# Database (SQLite for local dev, PostgreSQL for production)
DATABASE_URL=sqlite+aiosqlite:///./plum_opd.db
# DATABASE_URL=postgresql+asyncpg://plum_admin:plum_secret_dev@localhost:5432/plum_opd

# OpenAI (optional — for GPT-4o Vision document processing)
OPENAI_API_KEY=sk-your-key-here

# CORS
CORS_ORIGINS=http://localhost:3000

# Tesseract OCR path (optional)
TESSERACT_PATH=tesseract

# File uploads directory
UPLOAD_DIR=./uploads

# Environment
APP_ENV=development
